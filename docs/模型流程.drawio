<mxfile host="Evo" version="24.7.17">
  <diagram id="evo-model-flow" name="模型流程">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="3600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Evo 模型流程（0.3.0）：打开 Apex 之后，Evo 怎么一步步认出画面、记下一局" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=24;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="按 0.3.0 的代码画的（2026-10-18）。每一条规则为什么这样定，见 docs/对局全流程图.md。改了模型（识别逻辑）以后，这张图也要跟着改。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=14;fontColor=#1a1a1a;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1500" height="26" as="geometry"/></mxCell>
        <mxCell id="lg0" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=14;fontColor=#1a1a1a;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="60" height="28" as="geometry"/></mxCell>
        <mxCell id="lgb0" value="每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="104" y="105" width="110" height="26" as="geometry"/></mxCell>
        <mxCell id="lgb1" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="224" y="105" width="124" height="26" as="geometry"/></mxCell>
        <mxCell id="lgb2" value="不截屏" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6c757d;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="358" y="105" width="80" height="26" as="geometry"/></mxCell>
        <mxCell id="lgt1" value="截图频率" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="448" y="104" width="80" height="28" as="geometry"/></mxCell>
        <mxCell id="lgr0" value="写进数据库" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="558" y="104" width="100" height="28" as="geometry"/></mxCell>
        <mxCell id="lgr1" value="先记在内存里，存这一局时一起写" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="668" y="104" width="230" height="28" as="geometry"/></mxCell>
        <mxCell id="lgr2" value="什么都不记" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="908" y="104" width="100" height="28" as="geometry"/></mxCell>
        <mxCell id="lgt2" value="每个阶段的结果" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="1018" y="104" width="120" height="28" as="geometry"/></mxCell>
        <mxCell id="lgd1" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1158" y="108" width="1" height="20" as="geometry"/></mxCell>
        <mxCell id="lgd2" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1228" y="108" width="1" height="20" as="geometry"/></mxCell>
        <mxCell id="lgde" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="lgd1" target="lgd2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lgt3" value="不一定会走的路线" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;verticalAlign=middle;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="1234" y="104" width="150" height="28" as="geometry"/></mxCell>
        <mxCell id="A" value="Ⅰ 托盘程序：打开 Evo 后一直在（约 37 MB，只看进程名，不截屏）" style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#f1f3f5;strokeColor=#868e96;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1720" height="200" as="geometry"/></mxCell>
        <mxCell id="a1" value="打开 Evo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="A"><mxGeometry x="30" y="75" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="a2" value="看一眼进程列表&lt;br&gt;（只看进程名，不截屏、不碰游戏）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="A"><mxGeometry x="200" y="70" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a2b" value="每 5 秒一次" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6c757d;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="A"><mxGeometry x="350" y="57" width="120" height="26" as="geometry"/></mxCell>
        <mxCell id="a3" value="有 r5apex.exe 或&lt;br&gt;r5apex_dx12.exe，&lt;br&gt;并且没点暂停？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;" vertex="1" parent="A"><mxGeometry x="520" y="42" width="260" height="126" as="geometry"/></mxCell>
        <mxCell id="a4" value="启动&lt;b&gt;记录子进程&lt;/b&gt;&lt;br&gt;（单独的进程，记录时约 200 MB）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="A"><mxGeometry x="850" y="70" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;游戏关掉 / 点了暂停 / 退出 Evo 时&lt;/b&gt;&lt;br&gt;让记录子进程收尾：存下没存完的局（见 ⑨），释放引擎和截屏，进程退出，内存全部还给系统。之后继续每 5 秒看一次进程列表。&lt;br&gt;（记录子进程出错：等 60 秒再重新开始）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="A"><mxGeometry x="1230" y="46" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="e_a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_a34" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_a32" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a2"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="344"/><mxPoint x="370" y="344"/></Array></mxGeometry></mxCell>
        <mxCell id="e_a45" value="游戏关掉 / 暂停" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="B" value="Ⅱ 记录子进程：每截一张图，先判断是哪个画面（live_collect.py）" style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#e7f0fb;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1720" height="300" as="geometry"/></mxCell>
        <mxCell id="b1" value="截一张全屏（dxcam：只截屏，不碰游戏）&lt;br&gt;按游戏画面比例换算区域（layout.py）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="B"><mxGeometry x="30" y="80" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="b1b" value="平时每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="B"><mxGeometry x="30" y="165" width="250" height="28" as="geometry"/></mxCell>
        <mxCell id="b1o" value="对局中、总结页还没存下时：&lt;br&gt;每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="B"><mxGeometry x="30" y="202" width="250" height="48" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;画面判断&lt;/b&gt;（screens.py）&lt;br&gt;每张图都按这个顺序检查，认出一个就停：&lt;br&gt;&lt;b&gt;总结页 → 经验值页 → 开局画面 → 大厅 → 淘汰画面 → 冠军横幅 → 返回大厅按钮&lt;/b&gt;&lt;br&gt;① 先比文字轮廓和参照图像不像（几毫秒，不用引擎；纯色的位置不算）&lt;br&gt;② 像了，再用引擎读关键字确认&lt;br&gt;游戏语言（game_lang.py）：设置页手动选了就只按它；自动识别时每种语言各比一次，只有一种语言的关键字对得上就认定，之后只按它比&lt;br&gt;同一个画面有几种样子时各一张参照图（as），如匹配局的开局横幅&quot;TRIOS&quot;&quot;三人赛&quot;、匹配大厅&quot;未上榜&quot;&lt;br&gt;7 种都不是：看左下角认不认得出自己的传奇（④⑤）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="B"><mxGeometry x="330" y="55" width="470" height="225" as="geometry"/></mxCell>
        <mxCell id="b3" value="认出是&lt;br&gt;哪个画面？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1a1a1a;fontSize=13;" vertex="1" parent="B"><mxGeometry x="850" y="80" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;要注意&lt;/b&gt;&lt;br&gt;• 对局中（开局画面之后、结算画面之前）每 0.3 秒一张，用来实测 CPU（config/hud.json 的 match_interval）；其他时候每 1 秒一张&lt;br&gt;• 交火时&lt;b&gt;不用引擎&lt;/b&gt;：右上角那块只存在内存里，一局结束时才读&lt;br&gt;• 引擎（OCR）用到时才加载，闲置 2 分钟就释放&lt;br&gt;• 日志里每 5 分钟写一行 CPU、内存占用；记录结束时写整段的平均&lt;br&gt;• 连续 45 分钟一个画面都没认出（不在对局中时）：在日志里提醒（可能游戏改了界面）&lt;br&gt;• 游戏画面比例（16:9 / 16:10 / 4:3）：每 5 秒看一眼设置页的选项，自动检测时读 Apex 的视频设置文件（只读，见 game_aspect.py）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="B"><mxGeometry x="1080" y="50" width="610" height="230" as="geometry"/></mxCell>
        <mxCell id="e_ab" value="子进程开始工作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.56686;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="B"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="C" value="Ⅲ 一局的行动线（按游戏里的先后顺序）：每个阶段的截图频率、怎么认出、做什么、记下什么" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#343a40;strokeColor=#343a40;fontColor=#1a1a1a;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#ffffff;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="760" width="1060" height="46" as="geometry"/></mxCell>
        <mxCell id="e_bc" value="认出哪个画面，就交给 Ⅲ 里那个阶段" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.641509;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="C"><mxGeometry x="0.45" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1" value='① 大厅&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;lobby.py · calibration.py · config/lobby.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="870" width="1060" height="206.5" as="geometry"/></mxCell>
        <mxCell id="p1b0" value="每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p1"><mxGeometry x="20" y="48" width="101.34" height="26" as="geometry"/></mxCell>
        <mxCell id="p1how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;左下角段位栏里的“排位点数”" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p1"><mxGeometry x="14" y="80" width="250" height="112.5" as="geometry"/></mxCell>
        <mxCell id="p1do" value="• 一进来：给上一局收尾（见 ⑨）&lt;br&gt;• 每张都读：左上角组队列表第一行的&lt;b&gt;玩家名&lt;/b&gt;、左下角的&lt;b&gt;段位和段内分数&lt;/b&gt;（段以徽章下面的罗马数字为准），换算成总分&lt;br&gt;• 连续两次读到一样就记下，这次停在大厅不再读（最多读 6 次）&lt;br&gt;• &lt;b&gt;大厅校准&lt;/b&gt;：和上一次大厅比，中间各局 RP 加起来应等于总分之差。只缺一局就补上；对不上标待确认；跨大段（升段奖励、降段保护）不核对&lt;br&gt;• 大厅之前最近那一局没有段位：补上这次读到的" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p1"><mxGeometry x="278" y="46" width="500" height="144.5" as="geometry"/></mxCell>
        <mxCell id="p1res" value="&lt;b&gt;写进数据库&lt;/b&gt;&lt;br&gt;大厅读数（总分以它为准）&lt;br&gt;缺的那一局的 RP（来源：大厅校准）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p1"><mxGeometry x="792" y="48" width="254" height="144.5" as="geometry"/></mxCell>
        <mxCell id="p2" value='② 开局画面&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;match_start.py · config/match_start.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="1140.5" width="1060" height="168.5" as="geometry"/></mxCell>
        <mxCell id="p2b0" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p2"><mxGeometry x="20" y="48" width="116.42" height="26" as="geometry"/></mxCell>
        <mxCell id="p2how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;左上角横幅里的“排位赛”（后面有没有“- 空降地点”都认）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p2"><mxGeometry x="14" y="80" width="250" height="74.5" as="geometry"/></mxCell>
        <mxCell id="p2do" value="• 一进来：给上一局收尾（见 ⑨）；之前认出的传奇作废（比如靶场里的）；开始“对局中”，截图加快到每 0.3 秒一张&lt;br&gt;• 每张都用引擎读&lt;b&gt;模式&lt;/b&gt;和&lt;b&gt;地图&lt;/b&gt;，两项都读到就不再读" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p2"><mxGeometry x="278" y="46" width="500" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p2res" value="&lt;b&gt;先记在内存里&lt;/b&gt;&lt;br&gt;模式、地图" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p2"><mxGeometry x="792" y="48" width="254" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p3" value='③ 选角色&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;（不专门处理）&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="1373" width="1060" height="168.5" as="geometry"/></mxCell>
        <mxCell id="p3b0" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p3"><mxGeometry x="20" y="48" width="116.42" height="26" as="geometry"/></mxCell>
        <mxCell id="p3how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;不认它：7 种画面都不是，左下角也没有自己的头像" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p3"><mxGeometry x="14" y="80" width="250" height="74.5" as="geometry"/></mxCell>
        <mxCell id="p3do" value="• 等同待机，什么都不读（玩家轮流选，画面复杂，信息少）&lt;br&gt;• 传奇等跳伞以后从左下角头像认" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p3"><mxGeometry x="278" y="46" width="500" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p3res" value="&lt;b&gt;什么都不记&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p3"><mxGeometry x="792" y="48" width="254" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p4" value='④ 对局中（存活）&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;in_match.py · hud.py · config/hud.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="1605.5" width="1060" height="206.5" as="geometry"/></mxCell>
        <mxCell id="p4b0" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p4"><mxGeometry x="20" y="48" width="116.42" height="26" as="geometry"/></mxCell>
        <mxCell id="p4how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;7 种画面都不是，并且左下角认得出自己的传奇（认得出 = 自己的界面，不是观战）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p4"><mxGeometry x="14" y="80" width="250" height="112.5" as="geometry"/></mxCell>
        <mxCell id="p4do" value="• 每张都认自己的传奇（比参照图，不用引擎），同一个传奇 2 次算数&lt;br&gt;• 认两名队友的传奇（参照图缩小到 0.65 倍），2 次算数，一局只认一次；名字那一条裁下来先留着&lt;br&gt;• 还不知道玩家名：头像旁边的名字裁下来先留着&lt;br&gt;• &lt;b&gt;右上角&lt;/b&gt;那一块存在内存里（内容变了才存，只留最近 3 块）：剩余小队、击杀、助攻、老板分、伤害、RP&lt;br&gt;• 没倒地时看右下角&lt;b&gt;手上的武器&lt;/b&gt;（图标比参照图 config/templates/weapons/，变了才比），记下每一段拿在手上的时间&lt;br&gt;• 这时&lt;b&gt;不用引擎&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p4"><mxGeometry x="278" y="46" width="500" height="144.5" as="geometry"/></mxCell>
        <mxCell id="p4res" value="&lt;b&gt;先记在内存里&lt;/b&gt;&lt;br&gt;自己和队友的传奇、右上角、名字那一条、每一段手上的武器" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p4"><mxGeometry x="792" y="48" width="254" height="144.5" as="geometry"/></mxCell>
        <mxCell id="p5" value='⑤ 倒地 / 成盒 / 观战&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;in_match.py · hud.py&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="1876" width="1060" height="186" as="geometry"/></mxCell>
        <mxCell id="p5b0" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p5"><mxGeometry x="20" y="48" width="116.42" height="26" as="geometry"/></mxCell>
        <mxCell id="p5how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;倒地：自己那一行的边框和名字变红&lt;br&gt;成盒：认不出自己的界面，顶部有“观战”标签" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p5"><mxGeometry x="14" y="80" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="p5do" value="• 倒地：还是自己的界面，右上角照常存；武器不计时&lt;br&gt;• 成盒：右上角是被观战的人的，不存；记下“成盒”&lt;br&gt;• 成盒以后认被观战的人的传奇：是队友 = 队友还活着；不是 = 自己是小队最后一个被淘汰的&lt;br&gt;• 被队友救起、被重生信标复活：回到存活，继续记录" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p5"><mxGeometry x="278" y="46" width="500" height="124" as="geometry"/></mxCell>
        <mxCell id="p5res" value="&lt;b&gt;先记在内存里&lt;/b&gt;&lt;br&gt;自己的状态：存活 / 倒地 / 成盒" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p5"><mxGeometry x="792" y="48" width="254" height="124" as="geometry"/></mxCell>
        <mxCell id="p6" value='⑥ 一局结束：淘汰画面 / 冠军横幅 / 返回大厅&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;eliminated.py · in_match.py · config/eliminated.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="2126" width="1060" height="256" as="geometry"/></mxCell>
        <mxCell id="p6b0" value="每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p6"><mxGeometry x="20" y="48" width="101.34" height="26" as="geometry"/></mxCell>
        <mxCell id="p6how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;淘汰画面：屏幕中间的“排名第”&lt;br&gt;冠军横幅：“你已成为 捍卫者”&lt;br&gt;返回大厅：右下角的按钮（小队已淘汰；观战还活着的队友时没有）&lt;br&gt;（直接到总结页、经验值页，回大厅，成盒后直接进下一局，停止记录，也算结束）&lt;br&gt;前三种响提示音" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p6"><mxGeometry x="14" y="80" width="250" height="162" as="geometry"/></mxCell>
        <mxCell id="p6do" value="• 先用引擎读内存里的右上角（从最新的往回读），每项取最后一次读到的；击杀、助攻、老板分、伤害从没显示过算 0&lt;br&gt;• 读队友的名字、自己的名字&lt;br&gt;• RP、名次（剩余小队）：自己是最后一个被淘汰的（倒地时全队被淘汰、成盒后观战的是对手）是最终的；队友还活着时先成盒的、拿冠军的（名次分结束后才加）不用，等经验值页或大厅校准&lt;br&gt;• 击杀、助攻、老板分那一行：先找每一项前面的图标，读图标右边的数字（位数一变位置就跟着变）；骷髅或握手图标在、数字读不出来就留空；老板分图标不在也留空；整行从没显示过才算 0&lt;br&gt;• 每一段手上的武器记进 weapon_holds 表（数据页“最常用武器”只算第一次拿到武器 1 分钟以后的）&lt;br&gt;• 淘汰画面读“排名第 X”（一局只认第一次）；冠军横幅记第 1 名&lt;br&gt;• 截图回到每秒一张" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p6"><mxGeometry x="278" y="46" width="500" height="194" as="geometry"/></mxCell>
        <mxCell id="p6res" value="&lt;b&gt;交给“一局”&lt;/b&gt;&lt;br&gt;对局中最后的读数、名次&lt;br&gt;（这一局已经存下就马上写进数据库）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p6"><mxGeometry x="792" y="48" width="254" height="194" as="geometry"/></mxCell>
        <mxCell id="p7" value='⑦ 总结页&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;summary_page.py · teammates.py · config/summary.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="2446" width="1060" height="218" as="geometry"/></mxCell>
        <mxCell id="p7b0" value="每 0.3 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8590c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p7"><mxGeometry x="20" y="48" width="116.42" height="26" as="geometry"/></mxCell>
        <mxCell id="p7b1" value="存下后：每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p7"><mxGeometry x="20" y="80" width="153.34" height="26" as="geometry"/></mxCell>
        <mxCell id="p7how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;中间卡片上的“击杀”“助攻”&lt;br&gt;（冠军也有总结页，顶部写“捍卫者”；第 2 名有时没有）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p7"><mxGeometry x="14" y="112" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="p7do" value="• 每张读 7 项；名次、击杀/助攻/击倒、伤害都读到并且连续两次一样就存&lt;br&gt;• 等了 10 秒、提前离开、停止记录：用读得最全的一张存下；缺的项之后用别的来源补上就不用确认&lt;br&gt;• 冠军（顶部“捍卫者”）不等名次；存下时响提示音&lt;br&gt;• 同一张再读：左右两名队友（名字、ID、数据）、自己的名字、顶部是不是“捍卫者”&lt;br&gt;• 队友按名字和对局中认出的对上：名字以对局中为准，补上传奇" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p7"><mxGeometry x="278" y="46" width="500" height="156" as="geometry"/></mxCell>
        <mxCell id="p7res" value="&lt;b&gt;写进数据库：新增一局&lt;/b&gt;&lt;br&gt;各来源按优先级合并（见右边）&lt;br&gt;+ 两名队友 + 截图 1 张" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p7"><mxGeometry x="792" y="48" width="254" height="156" as="geometry"/></mxCell>
        <mxCell id="p8" value='⑧ 经验值页&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;xp_page.py · ranks.py · config/xp.json&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="2728" width="1060" height="168.5" as="geometry"/></mxCell>
        <mxCell id="p8b0" value="每 1 秒一张" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f6fd1;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p8"><mxGeometry x="20" y="48" width="101.34" height="26" as="geometry"/></mxCell>
        <mxCell id="p8how" value="&lt;b&gt;怎么认出&lt;/b&gt;&lt;br&gt;左边的“排位点数总计”&lt;br&gt;（要手动按 LB / RB 切过来）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p8"><mxGeometry x="14" y="80" width="250" height="74.5" as="geometry"/></mxCell>
        <mxCell id="p8do" value="• 进入时响提示音；离开时识别最后一张：RP = 战斗 + 奖励 + 定级三个合计、名次、计分击杀/助攻、段位和段内进度&lt;br&gt;• 核对通过、和总结页对得上 → 补进同一局；对不上 → 单独记一局，标待确认&lt;br&gt;• 一直没读全：RP 用对局中的（只限自己最后被淘汰），再不行等大厅校准" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p8"><mxGeometry x="278" y="46" width="500" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p8res" value="&lt;b&gt;写进数据库&lt;/b&gt;&lt;br&gt;RP（最优先）、段位、段内进度&lt;br&gt;+ 截图 1 张" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p8"><mxGeometry x="792" y="48" width="254" height="106.5" as="geometry"/></mxCell>
        <mxCell id="p9" value='⑨ 一局收尾&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style="font-size:12px;font-weight:normal;color:#495057;"&gt;post_match.py · screenshots.py&lt;/span&gt;' style="swimlane;startSize=36;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fontStyle=1;fontSize=16;fontColor=#1a1a1a;fillColor=#e9ecef;strokeColor=#868e96;swimlaneFillColor=#ffffff;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="2960.5" width="1060" height="224" as="geometry"/></mxCell>
        <mxCell id="p9b0" value="不截屏" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6c757d;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="p9"><mxGeometry x="20" y="48" width="73" height="26" as="geometry"/></mxCell>
        <mxCell id="p9how" value="&lt;b&gt;什么时候&lt;/b&gt;&lt;br&gt;• 下一次开局画面&lt;br&gt;• 回到大厅&lt;br&gt;• 停止记录&lt;br&gt;• 新的结算画面隔了 2 分钟以上" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p9"><mxGeometry x="14" y="80" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="p9do" value="• 没有总结页的局单独记一局：有经验值页 → 用经验值页（加上对局中的）；只有对局中的数据 → 用对局中的（看到了开局画面或结算画面才记，靶场的不记）；只有淘汰画面 → 只有名次&lt;br&gt;• 回到大厅才结束的（提前回大厅）：名次、RP 等大厅校准；成盒后直接进了下一局（队长重新匹配）：不用确认；还活着就没了下文（掉线、停止记录）：标待确认&lt;br&gt;• 清掉内存里这一局的模式、地图、传奇&lt;br&gt;• 删截图：只留待确认的局要用的（开着“保留全部截图”时都不删）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="p9"><mxGeometry x="278" y="46" width="500" height="162" as="geometry"/></mxCell>
        <mxCell id="p9res" value="&lt;b&gt;可能写进数据库&lt;/b&gt;&lt;br&gt;没有总结页的局新增一局&lt;br&gt;&lt;br&gt;删掉不需要的截图" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;" vertex="1" parent="p9"><mxGeometry x="792" y="48" width="254" height="162" as="geometry"/></mxCell>
        <mxCell id="e_p1p2" value="排队、进入对局" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p2p3" value="选传奇" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3p4" value="开始跳伞" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4p5" value="被击倒 / 阵亡" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p5p6" value="全队被淘汰" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p6p7" value="自动进入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="p7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p7p8" value="手动切换（LB / RB）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="p7" target="p8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p8p9" value="下一局开局 / 回大厅 / 停止记录" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8" target="p9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p5p4" value="被救起 /&lt;br&gt;复活" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p5" target="p4"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1969"/><mxPoint x="240" y="1766.57"/></Array></mxGeometry></mxCell>
        <mxCell id="e_p4p6" value="拿冠军" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p4" target="p6"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="1667.45"/><mxPoint x="170" y="2215.6"/></Array></mxGeometry></mxCell>
        <mxCell id="e_p6p8" value="没有总结页&lt;br&gt;（第 2 名有时）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p6" target="p8"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="2279.6"/><mxPoint x="240" y="2778.55"/></Array></mxGeometry></mxCell>
        <mxCell id="e_p9p2" value="下一局&lt;br&gt;（或先回大厅）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p9" target="p2"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="3072.5"/><mxPoint x="90" y="1224.75"/></Array></mxGeometry></mxCell>
        <mxCell id="prio" value="&lt;b&gt;各来源的优先级&lt;/b&gt;（post_match.settle）&lt;br&gt;&lt;br&gt;每个来源读到的数都单独记一行（readings 表），每一项按这个顺序定：&lt;br&gt;&lt;br&gt;• &lt;b&gt;名次&lt;/b&gt;：总结页、经验值页、冠军横幅、淘汰画面互相核对，对不上标待确认；都没有时用对局中的剩余小队数&lt;br&gt;• &lt;b&gt;击杀、助攻&lt;/b&gt;：总结页 → 对局中 → 经验值页（计分次数）&lt;br&gt;• &lt;b&gt;伤害&lt;/b&gt;：总结页 → 对局中&lt;br&gt;• &lt;b&gt;老板分&lt;/b&gt;：对局中&lt;br&gt;• &lt;b&gt;RP&lt;/b&gt;：经验值页 → 对局中（只限自己最后被淘汰；冠军不用）→ 大厅校准&lt;br&gt;• &lt;b&gt;段位、总分&lt;/b&gt;：大厅 → 经验值页&lt;br&gt;&lt;br&gt;对局中比总结页&lt;b&gt;少&lt;/b&gt;：正常（最后一秒没截到），不标；&lt;b&gt;多&lt;/b&gt;：有一边读错了，标待确认。&lt;br&gt;总结页没读全，缺的项别的来源补上了：不用确认" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e7f0fb;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="2166" width="350" height="690.5" as="geometry"/></mxCell>
        <mxCell id="e_p6prio" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.152064;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p6res" target="prio"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p7prio" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.58798;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p7res" target="prio"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p8prio" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a1a1a;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.960536;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p8res" target="prio"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="todo" value="&lt;b&gt;还没做、要在游戏里实测的&lt;/b&gt;（见 claude/todo.md）&lt;br&gt;• 截屏占 CPU：游戏里实测第一局（每 0.3 秒一张）记录子进程平均 14–16% 个核、内存约 210 MB；帧数不专门测了（2026-10-24 用户说玩家普遍反馈没有影响），最后的截图频率还要定&lt;br&gt;• “阵亡瞬间的 RP 就是最终 RP”还是推测：前几局拿经验值页核对（日志里的“RP 核对”）&lt;br&gt;• 2560×1440 实战（10-18 晚 8 局）：右上角击杀、助攻有时读不出来：原因是这一行的数字位置随位数变，10-20 改成先找图标再读，还要实战确认；双人赛还没有样本&lt;br&gt;• 匹配模式（右上角没有 RP）以后再做；击杀信息栏（kill_events）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#868e96;fontColor=#1a1a1a;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="40" y="3258.5" width="1720" height="137.5" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
